# Database connection. Exactly one DATABASE_URL line should be active -
# to switch, comment out the current one and uncomment the other.
#
# SQLite: zero setup, a file in backend/ - fine for trying the app locally.
# Run uvicorn from backend/ so the relative path resolves here.
# DATABASE_URL=sqlite:///./local.db
#
# PostgreSQL (the intended database): local install or a managed free tier
# (Neon / Supabase) - see docs/PROJECT_OVERVIEW.md.
DATABASE_URL=postgresql+psycopg2://csr_user:csr_password@localhost:5432/csr_outreach

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173

# Optional: enable contact enrichment (Phase 2). Leave blank to disable.
HUNTER_API_KEY=
APOLLO_API_KEY=

# NGO profile, used in AI-generated emails/summaries and lead scoring.
NGO_NAME=A Ray of Hope Foundation
NGO_WORK_AREA=educating underprivileged children
NGO_FOCUS_AREAS=Education
NGO_CITY=Pune
NGO_STATE=Maharashtra

# Optional: enable AI features (Phase 3: lead-score explanations, email/
# summary/meeting-brief generation). Leave blank to disable. Get a key
# at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Upload size caps (Phase 6). Defaults shown - only set these to override.
MAX_DOCUMENT_UPLOAD_BYTES=10485760
MAX_CSV_IMPORT_BYTES=5242880

# Real-company discovery (Companies page -> "Discover companies"). All
# optional - see docs/COMPANY_DISCOVERY.md. Wikidata works with no key.
# Email or URL sent in the User-Agent so Wikimedia/data.gov.in can reach you.
DISCOVERY_CONTACT=
WIKIDATA_ENABLED=true
WIKIDATA_REFRESH_HOURS=168
# MCA company registry via data.gov.in. Free key: register at
# https://data.gov.in and copy it from "My Account". Blank = source off.
DATA_GOV_IN_API_KEY=
MCA_RESOURCE_ID=4dbe5667-7b6b-41d7-82af-211562424d9a
# Folder of official CSVs you download (NSE/BSE lists, National CSR Portal
# exports) and the Wikidata index cache. Relative to backend/.
DISCOVERY_DATASETS_DIR=datasets
DISCOVERY_CACHE_DIR=.cache

# Email automation (docs/EMAIL_AUTOMATION.md). Emails are only ever sent
# when staff click "Confirm & send". Leave the Google values blank to keep
# Gmail disconnected (drafts and templates still work).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" on the Google OAuth client.
GMAIL_REDIRECT_URI=http://localhost:8000/api/email/oauth/gmail/callback
# Where Google sign-in returns the browser to (the React app).
FRONTEND_URL=http://localhost:5173
# Encrypts stored OAuth tokens. Required to connect Gmail. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Optional shared secret for connecting Gmail / sending / checking replies.
# Strongly recommended for any deployment reachable from the internet.
APP_ACCESS_TOKEN=
# Reply check + due follow-up drafts interval (0 = only the manual button).
EMAIL_SYNC_MINUTES=10
MAX_EMAILS_PER_HOUR=30
